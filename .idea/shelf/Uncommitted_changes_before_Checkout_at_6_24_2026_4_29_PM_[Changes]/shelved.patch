<+><!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>EduNest — Jefferson County Home & School Locator</title>\r\n    <link rel=\"stylesheet\" href=\"styles.css\" />\r\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet/dist/leaflet.css\" />\r\n  </head>\r\n  <body>\r\n    <header>\r\n      <div style=\"display:flex; align-items:center; justify-content:space-between;\">\r\n        <h1>EduNest — Jefferson County Home & School Locator</h1>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"layout\">\r\n      <!-- Sidebar -->\r\n      <aside class=\"sidebar\">\r\n        <h2>Navigation</h2>\r\n        <div style=\"display: flex; gap: 8px; flex-direction: column; margin-bottom: 12px;\">\r\n          <button onclick=\"switchTab('schools')\" class=\"tab-btn\" id=\"tab-schools\">\uD83D\uDCDA Schools</button>\r\n          <button onclick=\"switchTab('homes')\" class=\"tab-btn\" id=\"tab-homes\">\uD83C\uDFE0 Homes</button>\r\n          <button onclick=\"switchTab('saved')\" class=\"tab-btn\" id=\"tab-saved\">\uD83D\uDCBE Saved Homes</button>\r\n        </div>\r\n\r\n        <!-- Schools Search Panel -->\r\n        <div id=\"schools-sidebar\" style=\"display: block;\">\r\n          <h2>Find Schools</h2>\r\n          <label for=\"schoolSearch\">School name</label>\r\n          <input id=\"schoolSearch\" type=\"text\" placeholder=\"e.g., DuPont Manual\" />\r\n          <button id=\"schoolSearchBtn\" type=\"button\" style=\"width: 100%; margin-top: 8px;\">Search Schools</button>\r\n          <button id=\"allSchoolBtn\" type=\"button\" style=\"width: 100%; margin-top: 8px;\">Search Homes for all selected schools</button>\r\n          <h2 style=\"margin-top: 20px;\">Filter Schools</h2>\r\n          \r\n          <div style=\"margin-bottom: 16px;\">\r\n            <label>School Type</label>\r\n            <div style=\"display: flex; flex-direction: column; gap: 6px;\">\r\n              <label><input type=\"checkbox\" name=\"schoolType\" value=\"JCPS\"> Public</label>\r\n              <label><input type=\"checkbox\" name=\"schoolType\" value=\"Private\"> Private</label>\r\n              <label><input type=\"checkbox\" name=\"schoolType\" value=\"Parochial School\"> Catholic</label>\r\n            </div>\r\n          </div>\r\n\r\n          <div style=\"margin-bottom: 16px;\">\r\n            <label>Grade Level</label>\r\n            <div style=\"display: flex; flex-direction: column; gap: 6px;\">\r\n              <label><input type=\"checkbox\" name=\"gradeLevel\" value=\"Elementary\"> Elementary</label>\r\n              <label><input type=\"checkbox\" name=\"gradeLevel\" value=\"Middle\"> Middle</label>\r\n              <label><input type=\"checkbox\" name=\"gradeLevel\" value=\"High\"> High</label>\r\n            </div>\r\n          </div>\r\n\r\n          <label for=\"maxTuition\">Max Tuition: $<span id=\"maxTuitionValue\">5000</span></label>\r\n          <input id=\"maxTuition\" type=\"range\" min=\"0\" max=\"50000\" step=\"1000\" value=\"5000\" style=\"width: 100%;\" />\r\n\r\n          <button id=\"applyFiltersBtn\" type=\"button\" style=\"width: 100%; margin-top: 12px;\">Apply Filters</button>\r\n          \r\n        </div>\r\n\r\n        <!-- Homes Search Panel -->\r\n        <div id=\"homes-sidebar\" style=\"display: none;\">\r\n          <h2>Find Homes Near School</h2>\r\n          <label for=\"schoolSearchHome\">School name</label>\r\n          <input id=\"schoolSearchHome\" type=\"text\" placeholder=\"e.g., DuPont Manual High School\" />\r\n          <button id=\"schoolSearchHomeBtn\" type=\"button\" style=\"width: 100%; margin-top: 8px;\">Search Nearby Homes</button>\r\n\r\n          <h2 style=\"margin-top: 20px;\">Filter Homes</h2>\r\n          \r\n          <label for=\"minBedrooms\">Minimum bedrooms</label>\r\n          <select id=\"minBedrooms\" style=\"width: 100%;\">\r\n            <option value=\"0\">Any</option>\r\n            <option value=\"1\">1+</option>\r\n            <option value=\"2\">2+</option>\r\n            <option value=\"3\">3+</option>\r\n            <option value=\"4\">4+</option>\r\n          </select>\r\n\r\n          <label for=\"minBathrooms\" style=\"margin-top: 12px;\">Minimum bathrooms</label>\r\n          <select id=\"minBathrooms\" style=\"width: 100%;\">\r\n            <option value=\"0\">Any</option>\r\n            <option value=\"1\">1+</option>\r\n            <option value=\"2\">2+</option>\r\n            <option value=\"3\">3+</option>\r\n          </select>\r\n\r\n          <label for=\"maxPriceHome\" style=\"margin-top: 12px;\">Max Price: <span id=\"maxPriceValue\">300000</span></label>\r\n          <input id=\"maxPriceHome\" type=\"range\" min=\"50000\" max=\"1000000\" step=\"10000\" value=\"300000\" style=\"width: 100%;\" />\r\n\r\n          <button id=\"applyFiltersHomeBtn\" type=\"button\" style=\"width: 100%; margin-top: 12px;\">Apply Filters</button>\r\n          <div id=\"homeResults\" style=\"margin-top: 12px; font-size: 0.9rem; color: #475569;\"></div>\r\n        </div>\r\n\r\n        <h2 style=\"margin-top: 20px;\">Saved Homes</h2>\r\n        <div id=\"savedHousesCount\" style=\"font-size: 0.9rem; color: #475569; margin-bottom: 12px;\">0 homes saved</div>\r\n        <div id=\"savedHousesList\" style=\"max-height: 300px; overflow-y: auto;\"></div>\r\n      </aside>\r\n\r\n      <!-- Main Content -->\r\n      <main>\r\n        <!-- Schools Tab -->\r\n        <section id=\"schools-content\" style=\"display: block;max-width: 1000px;\">\r\n          <div style=\"margin-bottom: 20px;\">\r\n            <h2>School Directory</h2>\r\n            <p style=\"color: #475569;\">Browse and search schools in Jefferson County</p>\r\n          </div>\r\n          <div id=\"schoolResults\" style=\"margin-top: 12px; font-size: 0.9rem; color: #475569;\"></div>\r\n          <br><br>\r\n          <div class=\"school-list\">\r\n            <div class=\"school-list list-2\" id=\"schoolsList\">\r\n              <div class=\"navbar\">\r\n                <div style=\"font-weight: 600;\">School Name</div>\r\n                <div style=\"font-weight: 600;\">Address</div>\r\n                <div style=\"font-weight: 600;\">Type</div>\r\n                <div style=\"font-weight: 600;\">Grades</div>\r\n                <div style=\"font-weight: 600;\">Tuition</div>\r\n                <div style=\"font-weight: 600;\">Action</div>\r\n              </div>\r\n              <div id=\"schoolsTableBody\" style=\"display: flex; flex-direction: column; gap: 8px;\">\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- Homes Tab -->\r\n        <section id=\"homes-content\" style=\"display: none;max-width: 1000px;\">\r\n          <div style=\"margin-bottom: 20px;\">\r\n            <h2 id=\"resultsTitle\">Available Homes</h2>\r\n            <p style=\"color: #475569;\">Browse homes in your area</p>\r\n          </div>\r\n\r\n          <div id=\"mapContainer\" style=\"display: block;\">\r\n            <div id=\"map\"></div>\r\n          </div>\r\n\r\n          <div class=\"cards\" id=\"results\">\r\n            <div style=\"text-align: center; color: #475569; padding: 40px; grid-column: 1/-1;\">\r\n              Select filters and click \"Apply Filters\" to see results\r\n            </div>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- House Detail View -->\r\n        <section id=\"house-details-content\" style=\"display: none; max-width: 1000px;\">\r\n          <div style=\"display:flex; align-items:center; justify-content:space-between; gap: 16px; margin-bottom: 16px;\">\r\n            <div>\r\n              <h2 id=\"houseDetailTitle\">House Detail</h2>\r\n              <p id=\"houseDetailSubtitle\" style=\"color:#475569; margin:0;\">Click a home marker to view nearby schools.</p>\r\n            </div>\r\n            <button id=\"houseDetailBackBtn\" type=\"button\" style=\"padding: 10px 16px; border:none; background:#1f4f99; color:#fff; border-radius:8px; cursor:pointer;\">Back to Homes</button>\r\n          </div>\r\n\r\n\r\n          <div style=\"display:grid; grid-template-columns: 1.4fr 1fr; gap: 20px; align-items:start;\">\r\n            <div>\r\n              <div id=\"detailMap\" style=\"height: 520px; border:1px solid #d1d5db; border-radius: 12px; overflow:hidden;\"></div>\r\n              <div id=\"houseDetailInfo\" style=\"margin-top: 12px; color:#475569;\"></div>\r\n            </div>\r\n            <div style=\"display:flex; flex-direction:column; gap: 20px;\">\r\n              <div style=\"background:#fff; border:1px solid #d1d5db; border-radius:12px; padding:16px;\">\r\n                <h3 style=\"margin-top:0;\">Filter Nearby Schools</h3>\r\n                <div style=\"margin-bottom:12px;\">\r\n                  <strong>School Type</strong>\r\n                  <div style=\"display:flex; flex-direction:column; gap:8px; margin-top:8px;\">\r\n                    <label><input type=\"checkbox\" name=\"houseSchoolType\" value=\"JCPS\"> Public</label>\r\n                    <label><input type=\"checkbox\" name=\"houseSchoolType\" value=\"Private\"> Private</label>\r\n                    <label><input type=\"checkbox\" name=\"houseSchoolType\" value=\"Parochial School\"> Catholic</label>\r\n                  </div>\r\n                </div>\r\n                <div style=\"margin-bottom:12px;\">\r\n                  <strong>Grade Level</strong>\r\n                  <div style=\"display:flex; flex-direction:column; gap:8px; margin-top:8px;\">\r\n                    <label><input type=\"checkbox\" name=\"houseGradeLevel\" value=\"Elementary\"> Elementary</label>\r\n                    <label><input type=\"checkbox\" name=\"houseGradeLevel\" value=\"Middle\"> Middle</label>\r\n                    <label><input type=\"checkbox\" name=\"houseGradeLevel\" value=\"High\"> High</label>\r\n                  </div>\r\n                </div>\r\n                <div style=\"margin-bottom:12px;\">\r\n                  <label for=\"houseMaxTuition\">Max Tuition: $<span id=\"houseMaxTuitionValue\">5000</span></label>\r\n                  <input id=\"houseMaxTuition\" type=\"range\" min=\"0\" max=\"50000\" step=\"1000\" value=\"5000\" style=\"width:100%; margin-top:8px;\" />\r\n                </div>\r\n                <button id=\"houseApplySchoolFiltersBtn\" type=\"button\" style=\"width:100%; padding:10px 14px; border:none; border-radius:8px; background:#1f4f99; color:#fff; cursor:pointer;\">Apply School Filters</button>\r\n              </div>\r\n\r\n              <div style=\"background:#fff; border:1px solid #d1d5db; border-radius:12px; padding:16px;\">\r\n                <h3 style=\"margin-top:0;\">Nearby Schools</h3>\r\n                <div id=\"houseSchoolResults\" style=\"color:#475569; margin-bottom:12px;\">No school selected yet.</div>\r\n                <div id=\"houseNearbySchools\" style=\"display:grid; gap:12px; max-height: 420px; overflow-y:auto;\"></div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- Saved Homes Section -->\r\n        <section id=\"saved-content\" style=\"display: none;max-width: 1000px;\">\r\n          <h2>My Saved Homes</h2>\r\n          <div class=\"cards\" id=\"savedHouses\">\r\n            <div style=\"text-align: center; color: #475569; padding: 40px; grid-column: 1/-1;\" id=\"emptyState\">\r\n              No homes saved yet\r\n            </div>\r\n          </div>\r\n        </section>\r\n      </main>\r\n    </div>\r\n\r\n    <script src=\"https://unpkg.com/leaflet/dist/leaflet.js\"></script>\r\n    <script src=\"app.js\"></script>\r\n  </body>\r\n</html>\r\n
